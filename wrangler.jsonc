{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskpilot",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": {"binding": "BROWSER"},
  "triggers": {"crons": ["* * * * *"]},
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"PUBLIC_URL": "https://task-pilot.net", "MAIL_FROM": "connexion@mail.task-pilot.net"},
  "routes": [
    {"pattern": "task-pilot.net", "custom_domain": true},
    {"pattern": "www.task-pilot.net", "custom_domain": true}
  ],
  "durable_objects": {"bindings": [
    {"name": "ACCOUNTS", "class_name": "AccountAuthority"},
    {"name": "TRANSIT", "class_name": "TransitPlanner"},
    {"name": "BOT", "class_name": "BookingCoordinator"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AccountAuthority", "TransitPlanner"]},{"tag":"v2","new_sqlite_classes":["BookingCoordinator"]}],
  "observability": {"enabled": false}
}
